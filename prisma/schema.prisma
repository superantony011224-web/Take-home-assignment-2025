generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PatientProfile {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String
  dateOfBirth    String
  address        String
  insuranceCardUrl String?
  photoIdUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
